{
  "name": "cabt",
  "title": "Card Battle",
  "description": "Limited Card Battle.",
  "version": "1.0.0",
  "agents": [2],
  "configuration": {
    "episodeSteps": 10000000,
    "actTimeout": 0,
    "runTimeout": 2000,
    "bo": {
      "description": "The 'Best of' format (1 for BO1, 3 for BO3, etc.)",
      "type": "integer",
      "default": 3,
      "minimum": 1
    }
  },
  "reward": {
    "description": "Lost:-1, Won:1, Draw:0",
    "enum": [-1, 0, 1],
    "default": 0
  },
  "observation": {
    "remainingOverageTime": 600
  },
  "action": {
    "description": "List of option index.",
    "type": "array",
    "default": []
  },
  "status": {
    "defaults": ["INACTIVE", "INACTIVE"]
  }
}
